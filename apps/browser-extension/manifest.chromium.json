{
  "manifest_version": 3,
  "name": "Flint verification codes",
  "version": "0.1.0",
  "description": "Suggests verification codes that arrive in Flint when a page asks for one. Talks only to the Flint app on this Mac.",
  "key": "",
  "minimum_chrome_version": "110",
  "permissions": ["nativeMessaging"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "all_frames": true, "run_at": "document_idle" }
  ],
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
