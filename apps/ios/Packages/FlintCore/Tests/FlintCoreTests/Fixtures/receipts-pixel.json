{
  "meta": {
    "version": 1,
    "module": "receipts",
    "source": "packages/core/src/receipts/{client,pixel,protocol}.ts",
    "tokenRegex": "^[A-Za-z0-9_-]{22}$"
  },
  "cases": [
    {"name":"canonicalAddress \"Me@Example.com\"","input":{"fn":"canonicalAddress","address":"Me@Example.com"},"expect":"me@example.com"},
    {"name":"canonicalAddress \"  me@example.com  \"","input":{"fn":"canonicalAddress","address":"  me@example.com  "},"expect":"me@example.com"},
    {"name":"canonicalAddress \"first.last+x@googlemail.com\"","input":{"fn":"canonicalAddress","address":"first.last+x@googlemail.com"},"expect":"firstlast@gmail.com"},
    {"name":"canonicalAddress \"firstlast@gmail.com\"","input":{"fn":"canonicalAddress","address":"firstlast@gmail.com"},"expect":"firstlast@gmail.com"},
    {"name":"canonicalAddress \"First.Last+news@GMAIL.com\"","input":{"fn":"canonicalAddress","address":"First.Last+news@GMAIL.com"},"expect":"firstlast@gmail.com"},
    {"name":"canonicalAddress \"me+news@example.com\"","input":{"fn":"canonicalAddress","address":"me+news@example.com"},"expect":"me+news@example.com"},
    {"name":"canonicalAddress \"a.b@example.com\"","input":{"fn":"canonicalAddress","address":"a.b@example.com"},"expect":"a.b@example.com"},
    {"name":"canonicalAddress \"nodomain\"","input":{"fn":"canonicalAddress","address":"nodomain"},"expect":"nodomain"},
    {"name":"canonicalAddress \"@x.com\"","input":{"fn":"canonicalAddress","address":"@x.com"},"expect":"@x.com"},
    {"name":"canonicalAddress \"José.R@Gmail.com\"","input":{"fn":"canonicalAddress","address":"José.R@Gmail.com"},"expect":"josér@gmail.com"},
    {"name":"pixelTag https://r.example/i/abc.gif","input":{"fn":"pixelTag","url":"https://r.example/i/abc.gif"},"expect":"<img src=\"https://r.example/i/abc.gif\" width=\"1\" height=\"1\" alt=\"\" style=\"display:block;width:1px;height:1px;border:0;opacity:0\" />"},
    {"name":"pixelTag https://r/i/a\"b&c","input":{"fn":"pixelTag","url":"https://r/i/a\"b&c"},"expect":"<img src=\"https://r/i/a&quot;b&amp;c\" width=\"1\" height=\"1\" alt=\"\" style=\"display:block;width:1px;height:1px;border:0;opacity:0\" />"},
    {"name":"pixelTag https://r/i/a<b","input":{"fn":"pixelTag","url":"https://r/i/a<b"},"expect":"<img src=\"https://r/i/a&lt;b\" width=\"1\" height=\"1\" alt=\"\" style=\"display:block;width:1px;height:1px;border:0;opacity:0\" />"},
    {"name":"injectPixel body with attributes","input":{"fn":"injectPixel","html":"<html><body class=\"x\"><p>Hi</p></body></html>","pixelUrl":"https://r/i/t.gif"},"expect":"<html><body class=\"x\"><img src=\"https://r/i/t.gif\" width=\"1\" height=\"1\" alt=\"\" style=\"display:block;width:1px;height:1px;border:0;opacity:0\" /><p>Hi</p></body></html>"},
    {"name":"injectPixel uppercase body","input":{"fn":"injectPixel","html":"<BODY>x</BODY>","pixelUrl":"https://r/i/t.gif"},"expect":"<BODY><img src=\"https://r/i/t.gif\" width=\"1\" height=\"1\" alt=\"\" style=\"display:block;width:1px;height:1px;border:0;opacity:0\" />x</BODY>"},
    {"name":"injectPixel no body","input":{"fn":"injectPixel","html":"<p>x</p>","pixelUrl":"https://r/i/t.gif"},"expect":"<img src=\"https://r/i/t.gif\" width=\"1\" height=\"1\" alt=\"\" style=\"display:block;width:1px;height:1px;border:0;opacity:0\" /><p>x</p>"},
    {"name":"injectPixel body split across attrs","input":{"fn":"injectPixel","html":"<body\n  style=\"a:b\">z</body>","pixelUrl":"https://r/i/t.gif"},"expect":"<body\n  style=\"a:b\"><img src=\"https://r/i/t.gif\" width=\"1\" height=\"1\" alt=\"\" style=\"display:block;width:1px;height:1px;border:0;opacity:0\" />z</body>"},
    {"name":"injectPixel empty","input":{"fn":"injectPixel","html":"","pixelUrl":"https://r/i/t.gif"},"expect":"<img src=\"https://r/i/t.gif\" width=\"1\" height=\"1\" alt=\"\" style=\"display:block;width:1px;height:1px;border:0;opacity:0\" />"},
    {"name":"injectPixel bodyguard is not body","input":{"fn":"injectPixel","html":"<bodyguard>x</bodyguard>","pixelUrl":"https://r/i/t.gif"},"expect":"<img src=\"https://r/i/t.gif\" width=\"1\" height=\"1\" alt=\"\" style=\"display:block;width:1px;height:1px;border:0;opacity:0\" /><bodyguard>x</bodyguard>"},
    {"name":"normalizeEndpoint \" https://r.example/ \"","input":{"fn":"normalizeEndpoint","endpoint":" https://r.example/ "},"expect":"https://r.example"},
    {"name":"normalizeEndpoint \"\"","input":{"fn":"normalizeEndpoint","endpoint":""},"expect":null},
    {"name":"normalizeEndpoint \"http://r.example\"","input":{"fn":"normalizeEndpoint","endpoint":"http://r.example"},"expect":null},
    {"name":"normalizeEndpoint \"http://localhost:8787/\"","input":{"fn":"normalizeEndpoint","endpoint":"http://localhost:8787/"},"expect":"http://localhost:8787"},
    {"name":"normalizeEndpoint \"http://127.0.0.1:8787\"","input":{"fn":"normalizeEndpoint","endpoint":"http://127.0.0.1:8787"},"expect":"http://127.0.0.1:8787"},
    {"name":"normalizeEndpoint \"not a url\"","input":{"fn":"normalizeEndpoint","endpoint":"not a url"},"expect":null},
    {"name":"normalizeEndpoint \"ftp://r.example\"","input":{"fn":"normalizeEndpoint","endpoint":"ftp://r.example"},"expect":null},
    {"name":"normalizeEndpoint \"https://r.example/base/\"","input":{"fn":"normalizeEndpoint","endpoint":"https://r.example/base/"},"expect":"https://r.example/base"},
    {"name":"normalizeEndpoint \"https://r.example///\"","input":{"fn":"normalizeEndpoint","endpoint":"https://r.example///"},"expect":"https://r.example"},
    {"name":"normalizeEndpoint \"https://R.Example:8443/x\"","input":{"fn":"normalizeEndpoint","endpoint":"https://R.Example:8443/x"},"expect":"https://r.example:8443/x"},
    {"name":"pixelUrlFor","input":{"fn":"pixelUrlFor","endpoint":"https://r.example","token":"tok"},"expect":"https://r.example/i/tok.gif"},
    {"name":"tokenShape \"abcdefghijklmnopqrstuv\"","input":{"fn":"tokenShape","token":"abcdefghijklmnopqrstuv"},"expect":true},
    {"name":"tokenShape \"abcdefghijklmnopqrstu\"","input":{"fn":"tokenShape","token":"abcdefghijklmnopqrstu"},"expect":false},
    {"name":"tokenShape \"abcdefghijklmnopqrstuvw\"","input":{"fn":"tokenShape","token":"abcdefghijklmnopqrstuvw"},"expect":false},
    {"name":"tokenShape \"abc_efghijklmnopqrs-uv\"","input":{"fn":"tokenShape","token":"abc_efghijklmnopqrs-uv"},"expect":true},
    {"name":"tokenShape \"abcdefghijklmnopqrstu=\"","input":{"fn":"tokenShape","token":"abcdefghijklmnopqrstu="},"expect":false},
    {"name":"tokenShape \"abcdefghijklmnopqrstu\\n\"","input":{"fn":"tokenShape","token":"abcdefghijklmnopqrstu\n"},"expect":false},
    {"name":"tokenShape \"ábcdefghijklmnopqrstu\"","input":{"fn":"tokenShape","token":"ábcdefghijklmnopqrstu"},"expect":false}
  ]
}
