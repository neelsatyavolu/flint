{
  "meta": {
    "version": 1,
    "module": "receipts",
    "source": "packages/core/src/store/receiptStatus.ts",
    "note": "Counted opens are events of kind open; sawPrefetch is any prefetch event. Constants: FORWARD_GAP_MS 3600000.",
    "forwardGapMs": 3600000
  },
  "cases": [
    {"name":"recipient: no events, registered","input":{"fn":"recipient","events":[],"repliedAt":null,"registered":true,"untrackedReason":null},"expect":{"status":"sent","openCount":0,"firstOpenAt":null,"lastOpenAt":null,"note":null,"possiblyForwarded":false}},
    {"name":"recipient: no events, unregistered","input":{"fn":"recipient","events":[],"repliedAt":null,"registered":false,"untrackedReason":null},"expect":{"status":"untracked","openCount":0,"firstOpenAt":null,"lastOpenAt":null,"note":"Receipts unavailable for this message","possiblyForwarded":false}},
    {"name":"recipient: no events, unregistered with reason","input":{"fn":"recipient","events":[],"repliedAt":null,"registered":false,"untrackedReason":"Receipts off: plain-text mode"},"expect":{"status":"untracked","openCount":0,"firstOpenAt":null,"lastOpenAt":null,"note":"Receipts off: plain-text mode","possiblyForwarded":false}},
    {"name":"recipient: one open","input":{"fn":"recipient","events":[{"at":1000,"kind":"open","client":null,"fingerprint":null}],"repliedAt":null,"registered":true,"untrackedReason":null},"expect":{"status":"opened","openCount":1,"firstOpenAt":1000,"lastOpenAt":1000,"note":null,"possiblyForwarded":false}},
    {"name":"recipient: two opens out of order","input":{"fn":"recipient","events":[{"at":5000,"kind":"open","client":null,"fingerprint":null},{"at":1000,"kind":"open","client":null,"fingerprint":null}],"repliedAt":null,"registered":true,"untrackedReason":null},"expect":{"status":"opened","openCount":2,"firstOpenAt":1000,"lastOpenAt":5000,"note":null,"possiblyForwarded":false}},
    {"name":"recipient: prefetch only","input":{"fn":"recipient","events":[{"at":1000,"kind":"prefetch","client":null,"fingerprint":null}],"repliedAt":null,"registered":true,"untrackedReason":null},"expect":{"status":"unknowable","openCount":0,"firstOpenAt":null,"lastOpenAt":null,"note":"Apple Mail Privacy Protection loads images for every message, so opens can't be confirmed","possiblyForwarded":false}},
    {"name":"recipient: prefetch then open","input":{"fn":"recipient","events":[{"at":1000,"kind":"prefetch","client":null,"fingerprint":null},{"at":2000,"kind":"open","client":null,"fingerprint":null}],"repliedAt":null,"registered":true,"untrackedReason":null},"expect":{"status":"opened","openCount":1,"firstOpenAt":2000,"lastOpenAt":2000,"note":null,"possiblyForwarded":false}},
    {"name":"recipient: scanner only","input":{"fn":"recipient","events":[{"at":1000,"kind":"scanner","client":null,"fingerprint":null}],"repliedAt":null,"registered":true,"untrackedReason":null},"expect":{"status":"sent","openCount":0,"firstOpenAt":null,"lastOpenAt":null,"note":null,"possiblyForwarded":false}},
    {"name":"recipient: bot, self, duplicate only","input":{"fn":"recipient","events":[{"at":1,"kind":"bot","client":null,"fingerprint":null},{"at":2,"kind":"self","client":null,"fingerprint":null},{"at":3,"kind":"duplicate","client":null,"fingerprint":null}],"repliedAt":null,"registered":true,"untrackedReason":null},"expect":{"status":"sent","openCount":0,"firstOpenAt":null,"lastOpenAt":null,"note":null,"possiblyForwarded":false}},
    {"name":"recipient: reply beats open","input":{"fn":"recipient","events":[{"at":1000,"kind":"open","client":null,"fingerprint":null}],"repliedAt":9000,"registered":true,"untrackedReason":null},"expect":{"status":"replied","openCount":1,"firstOpenAt":1000,"lastOpenAt":1000,"note":null,"possiblyForwarded":false}},
    {"name":"recipient: reply without events","input":{"fn":"recipient","events":[],"repliedAt":9000,"registered":true,"untrackedReason":null},"expect":{"status":"replied","openCount":0,"firstOpenAt":null,"lastOpenAt":null,"note":null,"possiblyForwarded":false}},
    {"name":"recipient: reply on unregistered","input":{"fn":"recipient","events":[],"repliedAt":9000,"registered":false,"untrackedReason":null},"expect":{"status":"replied","openCount":0,"firstOpenAt":null,"lastOpenAt":null,"note":null,"possiblyForwarded":false}},
    {"name":"recipient: open on unregistered message","input":{"fn":"recipient","events":[{"at":1000,"kind":"open","client":null,"fingerprint":null}],"repliedAt":null,"registered":false,"untrackedReason":null},"expect":{"status":"opened","openCount":1,"firstOpenAt":1000,"lastOpenAt":1000,"note":null,"possiblyForwarded":false}},
    {"name":"recipient: forward suspected: new client and fingerprint after 2h","input":{"fn":"recipient","events":[{"at":0,"kind":"open","client":"Gmail","fingerprint":"a"},{"at":7200000,"kind":"open","client":"Outlook","fingerprint":"b"}],"repliedAt":null,"registered":true,"untrackedReason":null},"expect":{"status":"opened","openCount":2,"firstOpenAt":0,"lastOpenAt":7200000,"note":null,"possiblyForwarded":true}},
    {"name":"recipient: no forward: same client","input":{"fn":"recipient","events":[{"at":0,"kind":"open","client":"Gmail","fingerprint":"a"},{"at":7200000,"kind":"open","client":"Gmail","fingerprint":"b"}],"repliedAt":null,"registered":true,"untrackedReason":null},"expect":{"status":"opened","openCount":2,"firstOpenAt":0,"lastOpenAt":7200000,"note":null,"possiblyForwarded":false}},
    {"name":"recipient: no forward: same fingerprint","input":{"fn":"recipient","events":[{"at":0,"kind":"open","client":"Gmail","fingerprint":"a"},{"at":7200000,"kind":"open","client":"Outlook","fingerprint":"a"}],"repliedAt":null,"registered":true,"untrackedReason":null},"expect":{"status":"opened","openCount":2,"firstOpenAt":0,"lastOpenAt":7200000,"note":null,"possiblyForwarded":false}},
    {"name":"recipient: no forward: within an hour","input":{"fn":"recipient","events":[{"at":0,"kind":"open","client":"Gmail","fingerprint":"a"},{"at":3600000,"kind":"open","client":"Outlook","fingerprint":"b"}],"repliedAt":null,"registered":true,"untrackedReason":null},"expect":{"status":"opened","openCount":2,"firstOpenAt":0,"lastOpenAt":3600000,"note":null,"possiblyForwarded":false}},
    {"name":"recipient: forward: just over an hour","input":{"fn":"recipient","events":[{"at":0,"kind":"open","client":"Gmail","fingerprint":"a"},{"at":3600001,"kind":"open","client":"Outlook","fingerprint":"b"}],"repliedAt":null,"registered":true,"untrackedReason":null},"expect":{"status":"opened","openCount":2,"firstOpenAt":0,"lastOpenAt":3600001,"note":null,"possiblyForwarded":true}},
    {"name":"recipient: forward: null client and fingerprint on first open","input":{"fn":"recipient","events":[{"at":0,"kind":"open","client":null,"fingerprint":null},{"at":10800000,"kind":"open","client":"Outlook","fingerprint":"b"}],"repliedAt":null,"registered":true,"untrackedReason":null},"expect":{"status":"opened","openCount":2,"firstOpenAt":0,"lastOpenAt":10800000,"note":null,"possiblyForwarded":true}},
    {"name":"summary: no recipients","input":{"fn":"summarize","recipients":[]},"expect":{"opened":0,"total":0,"status":"sent","lastOpenAt":null}},
    {"name":"summary: all sent","input":{"fn":"summarize","recipients":[{"status":"sent","lastOpenAt":null},{"status":"sent","lastOpenAt":null}]},"expect":{"opened":0,"total":2,"status":"sent","lastOpenAt":null}},
    {"name":"summary: one opened","input":{"fn":"summarize","recipients":[{"status":"sent","lastOpenAt":null},{"status":"opened","lastOpenAt":50}]},"expect":{"opened":1,"total":2,"status":"opened","lastOpenAt":50}},
    {"name":"summary: opened and replied","input":{"fn":"summarize","recipients":[{"status":"opened","lastOpenAt":50},{"status":"replied","lastOpenAt":90}]},"expect":{"opened":2,"total":2,"status":"replied","lastOpenAt":90}},
    {"name":"summary: latest open wins","input":{"fn":"summarize","recipients":[{"status":"opened","lastOpenAt":90},{"status":"opened","lastOpenAt":50}]},"expect":{"opened":2,"total":2,"status":"opened","lastOpenAt":90}},
    {"name":"summary: all untracked","input":{"fn":"summarize","recipients":[{"status":"untracked","lastOpenAt":null}]},"expect":{"opened":0,"total":1,"status":"untracked","lastOpenAt":null}},
    {"name":"summary: unknowable and untracked","input":{"fn":"summarize","recipients":[{"status":"unknowable","lastOpenAt":null},{"status":"untracked","lastOpenAt":null}]},"expect":{"opened":0,"total":2,"status":"unknowable","lastOpenAt":null}},
    {"name":"summary: unknowable and sent","input":{"fn":"summarize","recipients":[{"status":"unknowable","lastOpenAt":null},{"status":"sent","lastOpenAt":null}]},"expect":{"opened":0,"total":2,"status":"sent","lastOpenAt":null}}
  ]
}
