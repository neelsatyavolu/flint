    "Flint has no account and no analytics. Your mail is stored on this %@.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flint has no account and no analytics. Your mail is stored on this %@."
          }
