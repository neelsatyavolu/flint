    {"name":"searchWhere before:2026-01-01 after:2025-01-01 is:snoozed is:pinned is:unread has:attachment in:Projects account:a@b.c in:archive","input":{"fn":"searchWhere","query":"before:2026-01-01 after:2025-01-01 is:snoozed is:pinned is:unread has:attachment in:Projects account:a@b.c in:archive","now":1800000000000},"expect":{"sql":"EXISTS (SELECT 1 FROM message_folders xf JOIN folders xr ON xr.id = xf.folder_id WHERE xf.message_id = m.id AND (lower(xr.name) = ? OR lower(xr.path) = ?)) AND (\n  m.id IN (SELECT xf.message_id FROM message_folders xf JOIN folders xr ON xr.id = xf.folder_id WHERE xr.role = 'archive')\n  OR (EXISTS (SELECT 1 FROM accounts xa WHERE xa.id = m.account_id AND xa.provider = 'gmail')\n      AND m.id IN (SELECT xf.message_id FROM message_folders xf JOIN folders xr ON xr.id = xf.folder_id WHERE xr.role = 'all')\n      AND NOT m.id IN (SELECT xf.message_id FROM message_folders xf JOIN folders xr ON xr.id = xf.folder_id WHERE xr.role = 'inbox') AND NOT m.id IN (SELECT xf.message_id FROM message_folders xf JOIN folders xr ON xr.id = xf.folder_id WHERE xr.role = 'trash') AND NOT m.id IN (SELECT xf.message_id FROM message_folders xf JOIN folders xr ON xr.id = xf.folder_id WHERE xr.role = 'spam')\n      AND NOT m.id IN (SELECT xf.message_id FROM message_folders xf JOIN folders xr ON xr.id = xf.folder_id WHERE xr.role = 'sent') AND NOT m.id IN (SELECT xf.message_id FROM message_folders xf JOIN folders xr ON xr.id = xf.folder_id WHERE xr.role = 'drafts'))\n) AND m.account_id IN (SELECT id FROM accounts WHERE lower(email) = ? OR id = ?) AND m.has_attachments = 1 AND m.seen = 0 AND t.pinned = 1 AND (t.snoozed_until IS NOT NULL AND t.snoozed_until > ?) AND m.date < ? AND m.date >= ?","params":["projects","projects","a@b.c","a@b.c",1800000000000,1767254400000,1735718400000],"excludeTrashSpam":false}},
    {"name":"searchWhere from:ann to:bob cc:cy subject:invoice","input":{"fn":"searchWhere","query":"from:ann to:bob cc:cy subject:invoice","now":1800000000000},"expect":{"sql":"m.from_json LIKE ? ESCAPE '\\' AND m.to_json LIKE ? ESCAPE '\\' AND m.cc_json LIKE ? ESCAPE '\\' AND m.subject LIKE ? ESCAPE '\\'","params":["%ann%","%bob%","%cy%","%invoice%"],"excludeTrashSpam":true}},
